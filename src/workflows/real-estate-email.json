    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst category = (data.category || 'other').toLowerCase();\n\n// ── All templates in one place ────────────────────────────────\n// Edit these anytime without touching any other node\nconst templates = {\n\n  buyer: {\n    context: `You are replying to a BUYER inquiry.\n    \nAlways include in your reply:\n1. Thank them for reaching out\n2. Ask for their budget range and desired area if not mentioned\n3. Ask for preferred property type (condo, house, duplex)\n4. Offer to schedule a discovery call or property visit\n5. Mention you have access to all MLS listings\n\nBooking link: https://calendly.com/YOURLINK\nPhone: +1 (514) XXX-XXXX\nAvailability: Monday to Friday, 9am to 6pm`,\n\n    signature: `Best regards,\n[Your Name]\nReal Estate Broker\n[Agency Name]\n+1 (514) XXX-XXXX\nwww.yourwebsite.com`\n  },\n\n  seller: {\n    context: `You are replying to a SELLER or property valuation request.\n\nAlways include in your reply:\n1. Express genuine interest in their property\n2. Offer a free Comparative Market Analysis (CMA)\n3. Ask for the property address and best time to connect\n4. Briefly mention your experience selling in their area\n5. Propose an in-person or virtual meeting this week\n\nBooking link: https://calendly.com/YOURLINK\nPhone: +1 (514) XXX-XXXX`,\n\n    signature: `Best regards,\n[Your Name]\nReal Estate Broker\n[Agency Name]\n+1 (514) XXX-XXXX\nwww.yourwebsite.com`\n  },\n\n  rental: {\n    context: `You are replying to a RENTAL inquiry (tenant or landlord).\n\nAlways include in your reply:\n1. Confirm you will verify property availability within 24h\n2. Ask for: desired move-in date, number of occupants, pets\n3. List required documents: 3 months pay stubs, photo ID,\n   credit check authorization form\n4. Offer to schedule a viewing at their convenience\n5. Mention your typical response time is within 24 hours\n\nBooking link: https://calendly.com/YOURLINK\nPhone: +1 (514) XXX-XXXX`,\n\n    signature: `Best regards,\n[Your Name]\nReal Estate Broker\n[Agency Name]\n+1 (514) XXX-XXXX\nwww.yourwebsite.com`\n  },\n\n  agent: {\n    context: `You are replying to a PROFESSIONAL contact\n(real estate agent, colleague, referral partner, or recruiter).\n\nAlways include in your reply:\n1. Acknowledge their message warmly and professionally\n2. Answer their specific question or request directly\n3. If it is a referral offer, express interest and ask for client details\n4. If it is a collaboration or co-listing, offer a quick call\n5. Keep the tone collegial and brief\n\nPhone: +1 (514) XXX-XXXX`,\n\n    signature: `Best regards,\n[Your Name]\nReal Estate Broker\n[Agency Name]\n+1 (514) XXX-XXXX`\n  },\n\n  other: {\n    context: `You are replying to a general inquiry that does not fit\na specific real estate category.\n\nAlways include in your reply:\n1. Acknowledge their message politely\n2. Answer their question clearly if possible\n3. Direct them to the right contact or next step\n4. Keep it short and professional\n\nPhone: +1 (514) XXX-XXXX`,\n\n    signature: `Best regards,\n[Your Name]\nReal Estate Broker\n[Agency Name]\n+1 (514) XXX-XXXX`\n  }\n\n};\n\n// ── Pick the right template ───────────────────────────────────\nconst selected = templates[category] || templates['other'];\n\nconsole.log('Category:', category);\nconsole.log('Template loaded:', category in templates ? 'exact match' : 'fallback to other');\n\nreturn [{\n  json: {\n    ...data,\n    templateContext:  selected.context,\n    templateSignature: selected.signature\n  }\n}];"
      },
      "id": "2124258e-8893-4cdf-8435-1dfb9a0e417d",
      "name": "Build Thread Text1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1840,
        992
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1. Get current thread data from the Gmail \"Get\" node\nconst threadData = $input.first().json;\n\n// 2. Get the Category from your Switch node\n// IMPORTANT: Change 'Switch' to the exact name of your Switch node\nconst switchNode = $('Switch').item.json;\nconst category = switchNode.category || 'No Category';\n\n/**\n * HELPER FUNCTIONS\n */\nfunction decodeBase64(encoded) {\n  if (!encoded) return '';\n  const base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');\n  try {\n    return Buffer.from(base64, 'base64').toString('utf-8');\n  } catch(e) { return ''; }\n}\n\nfunction cleanEmail(str) {\n  if (!str) return '';\n  const match = str.match(/<([^>]+)>/) || [null, str];\n  return match[1].toLowerCase().trim();\n}\n\nfunction getHeader(headers, name) {\n  if (!Array.isArray(headers)) return '';\n  const h = headers.find(h => h.name.toLowerCase() === name.toLowerCase());\n  return h?.value || '';\n}\n\nfunction extractBody(payload) {\n  if (!payload) return '';\n  // Simple body\n  if (payload.body?.data) return decodeBase64(payload.body.data);\n  // Multipart body\n  if (payload.parts?.length > 0) {\n    const plain = payload.parts.find(p => p.mimeType === 'text/plain');\n    if (plain?.body?.data) return decodeBase64(plain.body.data);\n    const html = payload.parts.find(p => p.mimeType === 'text/html');\n    if (html?.body?.data) {\n      return decodeBase64(html.body.data)\n        .replace(/<[^>]*>/g, ' ')\n        .replace(/\\s{2,}/g, '\\n').trim();\n    }\n    // Recursive check for nested parts\n    for (const part of payload.parts) {\n      if (part.parts) {\n        const nested = extractBody(part);\n        if (nested) return nested;\n      }\n    }\n  }\n  return '';\n}\n\n/**\n * MAIN PROCESSING logic\n */\nconst messages = threadData.messages || [];\n\nif (messages.length === 0) {\n  return [{ json: { skip: true, reason: 'empty thread' } }];\n}\n\n// Sort oldest to newest to track conversation flow\nconst sorted = [...messages].sort((a, b) =>\n  parseInt(a.internalDate || 0) - parseInt(b.internalDate || 0)\n);\n\n// Determine the \"Target User\" (the person who sent the most recent email)\nconst latestMessage = sorted[sorted.length - 1];\nconst targetSenderRaw = getHeader(latestMessage.payload?.headers, 'from');\nconst targetEmail = cleanEmail(targetSenderRaw);\n\n// Filter the history to ONLY emails sent by this specific user\nconst userHistory = sorted.filter(m => {\n  const sender = getHeader(m.payload?.headers, 'from');\n  return cleanEmail(sender) === targetEmail;\n});\n\n// Build the text block of the user's history\nconst historyText = userHistory.map((m, index) => {\n  const date = getHeader(m.payload?.headers, 'date');\n  const body = extractBody(m.payload) || m.snippet || '(no body)';\n  const trimmed = body.length > 2000 ? body.substring(0, 2000) + '... [trimmed]' : body;\n  \n  return `[EMAIL #${index + 1}]\\nDate: ${date}\\nContent: ${trimmed}`;\n}).join('\\n\\n' + '─'.repeat(40) + '\\n\\n');\n\n// FINAL OUTPUT\nreturn [{\n  json: {\n    category: category,\n    fromName: targetSenderRaw,\n    fromEmail: targetEmail,\n    userSentCount: userHistory.length, // How many emails this user sent in this thread\n    totalThreadMessages: sorted.length,\n    subject: getHeader(latestMessage.payload?.headers, 'Subject'),\n    threadId: threadData.id,\n    latestMessageId: latestMessage.id,\n    historyText: historyText,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
