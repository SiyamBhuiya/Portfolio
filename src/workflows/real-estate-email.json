        "messages": {
          "values": [
            {
              "content": "You are an email classifier for a real estate agency. Return ONLY valid JSON, no explanation, no markdown.\n\nCategories:\n- buyer (wants to purchase a property)\n- seller (wants to sell or get a valuation)\n- rental (tenant or landlord inquiry)\n- agent (colleague, referral, B2B, recruiter)\n- other (anything else)\n\nRespond ONLY with this JSON structure:\n{\"category\": \"buyer\", \"confidence\": \"high\", \"language\": \"en\"}",
              "role": "system"
            },
            {
              "content": "=Classify this email:\n\nFROM: {{ $json.From }}\nSUBJECT: {{ $json.Subject }}\nBODY: {{ $json.snippet }}"
            }
          ]
        },
        "options": {
          "maxTokens": 100,
          "temperature": 1
        }
      },
      "id": "1c6442d9-da28-48b9-b276-acd7295832fe",
      "name": "Classify Email (AI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        -3456,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst aiOutput = $('Classify Email (AI)').first().json;\n\nconst raw =\n  aiOutput?.message?.content ||\n  aiOutput?.text ||\n  aiOutput?.choices?.[0]?.message?.content || '';\n\nlet parsed = { category: 'other', confidence: 'low', language: 'en' };\ntry {\n  const clean = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch(e) {\n  const catMatch = raw.match(/\"category\"\\s*:\\s*\"(\\w+)\"/);\n  const langMatch = raw.match(/\"language\"\\s*:\\s*\"(\\w+)\"/);\n  if (catMatch) parsed.category = catMatch[1];\n  if (langMatch) parsed.language = langMatch[1];\n}\n\nreturn [{\n  json: {\n    ...data,\n    category:   parsed.category   || 'other',\n    confidence: parsed.confidence || 'low',\n    language:   parsed.language   || 'en',\n    labelName:  'RE/' + (parsed.category || 'other')\n  }\n}];"
      },
