      "parameters": {
        "description": "Use this tool to update a cell. Requirements: sheetName (string), rowIndex (number), columnLetter (string), and newValue (string/number)",
        "jsCode": "const input = $json;\n\nif (!input.sheetName || !input.rowIndex || !input.columnLetter || !input.newValue) {\n  return {\n    error: \"Missing parameters. Required: sheetName, rowIndex, columnLetter, newValue.\"\n  };\n}\n\nconst targetRange = `${input.sheetName}!${input.columnLetter}${input.rowIndex}`;\n\ntry {\n  return {\n    action: \"update\",\n    range: targetRange,\n    value: input.newValue,\n    status: \"Pending Execution\",\n    confirmation: `Prepared to update ${input.sheetName} at ${input.columnLetter}${input.rowIndex} with ${input.newValue}`\n  };\n} catch (error) {\n  return {\n    success: false,\n    message: error.message\n  };\n}"
      },
