    {
      "parameters": {
        "jsCode": "// Loop over all incoming clients from the Google Sheet\nfor (const item of $input.all()) {\n  \n  // 1. Map your Google Sheet columns (Update the text inside the brackets to match your exact column headers)\n  const spaces = parseFloat(item.json['Spaces']) || 0;\n  const price = parseFloat(item.json['Amount per Space']) || 0;\n\n  // 2. Calculate the Total Price\n  item.json.TotalPrice = spaces * price;\n\n  // 3. Generate the current month string (e.g., \"April 2026\")\n  const currentDate = new Date();\n  const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });\n  item.json.InvoiceMonth = monthFormatter.format(currentDate);\n\n  // 4. (Optional) Generate a unique Invoice Number for the PDF and Plaid tracking\n  const clientName = item.json['Client Name'] || 'Unknown';\n  // Removes spaces from the client name for a clean ID: e.g., \"INV-4-2026-JohnDoe\"\n  item.json.InvoiceNumber = `INV-${currentDate.getMonth() + 1}-${currentDate.getFullYear()}-${clientName.replace(/\\s+/g, '')}`;\n\n}\n\n// Return the updated data to pass into the Loop Node\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
