        "jsCode": "for (let item of $input.all()) {\n  if (item.binary && item.binary.data) {\n    // 1. Get original name from Drive\n    let originalName = item.binary.data.fileName || 'document';\n\n    // 2. Remove the old extension (everything after the last dot)\n    let baseName = originalName.lastIndexOf('.') !== -1 \n      ? originalName.substring(0, originalName.lastIndexOf('.')) \n      : originalName;\n\n    // 3. Force the new filename and MIME type\n    item.binary.data.fileName = `${baseName}.pdf`;\n    item.binary.data.mimeType = 'application/pdf';\n  }\n}\n\nreturn $input.all();\n"
      },
