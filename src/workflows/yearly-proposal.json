    {
      "parameters": {
        "jsCode": "// Normalize Notion pages into simple client objects\nfunction addSingaporeCode(phone) {\n  if (!phone) return '';\n  let cleaned = String(phone).replace(/[\\s\\-()]/g, '');\n\n  if (cleaned.startsWith('+')) {\n    // Already has a country code of some kind - leave it as is.\n    return cleaned;\n  }\n  if (cleaned.startsWith('65') && cleaned.length > 8) {\n    // Already has 65 prefix without the +.\n    return '+' + cleaned;\n  }\n  if (cleaned.startsWith('0')) {\n    // Local format like +10000000000 - drop the leading 0 before adding +65.\n    cleaned = cleaned.slice(1);\n  }\n  return '+65' + cleaned;\n}\n\nconst clients = $input.all().map(item => {\n  const props = item.json.property_ || item.json;\n  return {\n    notionPageId: (item.json.id || '').replace(/-/g, ''),\n    clientName: item.json.property_Name || item.json.property_name || item.json['Name'] || 'Client',\n    clientPhone: addSingaporeCode(item.json.property_mobile_number || item.json.property_mobile_number || item.json['Phone'] || ''),\n  };\n});\nreturn clients.map(c => ({ json: c }));"
      },
      "id": "8ea1e858-c58e-4f73-93d5-1d83825ad2f1",
      "name": "Normalize Client List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3568,
        2624
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "name@example.com",
          "mode": "list",
          "cachedResultName": "name@example.com"
        },
        "returnAll": true,
        "options": {
          "timeMin": "={{ $now.startOf('month').toISO() }}",
          "timeMax": "={{ $now.endOf('year').toISO() }}"
        }
      },
      "id": "9351e568-c701-44e0-ae75-16b6551fe030",
      "name": "Google Calendar - Get Year Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        -3792,
        2816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build every free 1-hour slot from now through Dec 31 of THIS year, 9am-5pm, Mon-Fri, minus busy events\nconst busyEvents = $input.all().map(item => ({\n  start: new Date(item.json.start?.dateTime || item.json.start?.date),\n  end: new Date(item.json.end?.dateTime || item.json.end?.date)\n})).filter(e => !isNaN(e.start) && !isNaN(e.end));\n\nconst businessStartHour = 9;\nconst businessEndHour = 17; // 5pm\nconst slotLengthMin = 60;\n\nconst now = new Date();\nlet cursor = new Date(now);\ncursor.setDate(cursor.getDate() + 1); // start from tomorrow\ncursor.setHours(0, 0, 0, 0);\n\n// End at Dec 31 of the CURRENT year, not 12 months from today\nconst endDate = new Date(now.getFullYear(), 11, 31, 23, 59, 59);\n\nlet slots = [];\n\nfor (let d = new Date(cursor); d <= endDate; d.setDate(d.getDate() + 1)) {\n  const dow = d.getDay();\n  if (dow === 0 || dow === 6) continue; // skip weekends\n\n  for (let h = businessStartHour; h < businessEndHour; h += slotLengthMin / 60) {\n    const slotStart = new Date(d);\n    slotStart.setHours(h, 0, 0, 0);\n    const slotEnd = new Date(slotStart.getTime() + slotLengthMin * 60000);\n\n    const overlaps = busyEvents.some(ev => slotStart < ev.end && slotEnd > ev.start);\n    if (!overlaps && slotStart > now) {\n      slots.push({\n        start: slotStart.toISOString(),\n        end: slotEnd.toISOString(),\n        monthKey: `${slotStart.getFullYear()}-${String(slotStart.getMonth() + 1).padStart(2, '0')}`\n      });\n    }\n  }\n}\n\nreturn [{ json: { allSlots: slots, totalSlots: slots.length } }];"
      },
      "id": "fd2e84c1-f85f-4c01-b07d-a8b3bdb8aaab",
      "name": "Generate Year Availability Pool",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3568,
        2816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Randomly assign each client 2 unique, never-repeated 1-hour slots\n// from ALL available slots across the year (today -> Dec 31 / however far the pool extends).\n// No \"closest\" bias - every client's two options are picked at random from the whole pool.\n\nconst clients = $items('Normalize Client List').map(i => i.json);\nconst pool = $items('Generate Year Availability Pool')[0].json.allSlots;\n\nif (!pool || pool.length === 0) {\n  throw new Error('No available slots found in the calendar for the configured range.');\n}\n\n// Fisher-Yates shuffle - randomizes the entire slot pool once, in place\nfunction shuffle(arr) {\n  const a = [...arr];\n  for (let i = a.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [a[i], a[j]] = [a[j], a[i]];\n  }\n  return a;\n}\n\nconst shuffledPool = shuffle(pool);\nconst totalSlotsAvailable = shuffledPool.length;\n\nif (totalSlotsAvailable < clients.length * 2) {\n  console.log(`Warning: only ${totalSlotsAvailable} slots available for ${clients.length} clients (need ${clients.length * 2}). Some clients will get marked NO_AVAILABLE_SLOTS.`);\n}\n\nconst results = [];\nlet cursor = 0;\n\nclients.forEach((client) => {\n  const option1 = shuffledPool[cursor];\n  const option2 = shuffledPool[cursor + 1];\n\n  if (!option1 || !option2) {\n    results.push({\n      ...client,\n      error: 'NO_AVAILABLE_SLOTS',\n      option1_text: null,\n      option2_text: null\n    });\n    return;\n  }\n\n  cursor += 2;\n  results.push(buildResult(client, option1, option2));\n});\n\nfunction formatSlot(iso) {\n  const d = new Date(iso);\n  const date = d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });\n  const time = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });\n  return `${date} at ${time}`;\n}\n\nfunction buildResult(client, o1, o2) {\n  return {\n    ...client,\n    option1_start: o1.start,\n    option1_end: o1.end,\n    option2_start: o2.start,\n    option2_end: o2.end,\n    option1_text: formatSlot(o1.start),\n    option2_text: formatSlot(o2.start),\n    assignedMonth: o1.monthKey\n  };\n}\n\nreturn results.map(r => ({ json: r }));"
      },
