    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst fieldData = raw.field_data || [];\n\n// Build a lookup map from field_data array\nconst fields = {};\nfor (const f of fieldData) {\n  fields[f.name] = (f.values?.[0] ?? '').toString().trim();\n}\n\n// Phone: strip non-digits, then prepend + if missing\nlet telefono = fields.phone_number || fields.PHONE || fields.phone || '';\ntelefono = telefono.replace(/[^\\d+]/g, '');\nif (telefono && !telefono.startsWith('+')) { telefono = '+' + telefono; }\n\nreturn [{\n  json: {\n    email:      fields.email || '',\n    name:       fields.full_name || fields.name || '',\n    telefono:   telefono,\n    instagram:  fields.instagram || '',\n    lead_id:    String(raw.id || ''),\n    form_id:    String(raw.form_id || ''),\n    ad_id:      String(raw.ad_id || ''),\n    created_at: raw.created_time || new Date().toISOString()\n  }\n}];\n"
      },
