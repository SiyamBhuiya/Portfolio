        "jsCode": "// Fallback: the AI's queryType didn't match any known category, or the question was too vague to route.\n// Ask the sender a clarifying question instead of silently dropping their message.\nconst trigger = $('Parse Interpretation').first().json;\n\nconst clarifyMessage = \"I want to make sure I get you the right info - could you clarify what you're asking? \" +\n  \"For example: a specific client's name, 'upcoming meetings', or 'recent customers'.\";\n\nreturn [{\n  json: {\n    clientPhone: trigger.clientPhone,\n    answer: clarifyMessage\n  }\n}];"
      },
