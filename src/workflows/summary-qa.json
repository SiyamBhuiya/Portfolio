    {
      "parameters": {
        "jsCode": "// Collect whichever Notion results actually ran, flatten into plain text context for the AI to reason over\nconst allInputs = $input.all();\n\nconst records = allInputs.map(item => {\n  const p = item.json;\n  const fields = Object.keys(p).filter(k => k.startsWith('property_'));\n  const lines = fields.map(k => `${k.replace('property_', '')}: ${JSON.stringify(p[k])}`);\n  return lines.join(', ');\n}).filter(Boolean);\n\nconst trigger = $('Parse Interpretation').first().json;\n\nreturn [{\n  json: {\n    clientPhone: trigger.clientPhone,\n    questionText: trigger.questionText,\n    contextRecords: records.length ? records.join('\\n---\\n') : 'No matching records found in the database.'\n  }\n}];"
      },
      "id": "1373b741-64a3-4517-b7a4-bbef26ab631e",
      "name": "Flatten Notion Results Into Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8368,
        4176
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = $json;\n\nconst answer =\n  out.output?.[0]?.content?.find(part => part?.type === 'output_text')?.text ||\n  out.output?.[0]?.content?.[0]?.text ||\n  out.text ||\n  out.content ||\n  out.message?.content ||\n  out.choices?.[0]?.message?.content ||\n  out.output_text ||\n  \"Sorry, I couldn't find that right now - a team member will follow up with you shortly.\";\n\nconst clientPhone = $('Flatten Notion Results Into Context').first().json.clientPhone;\n\nreturn [{ json: { clientPhone, answer: String(answer).trim() } }];"
      },
