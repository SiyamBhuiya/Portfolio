      "parameters": {
        "jsCode": "const out = $json;\n\nconst aiRaw =\n  out.output?.[0]?.content?.find(part => part?.type === 'output_text')?.text ||\n  out.output?.[0]?.content?.[0]?.text ||\n  out.text ||\n  out.content ||\n  out.message?.content ||\n  out.choices?.[0]?.message?.content ||\n  out.output_text ||\n  '{}';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(String(aiRaw).replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = { queryType: 'other', clientNameGuess: null, searchTerm: null };\n}\n\nconst trigger = $('Map Main Workflow Input').first().json;\n\nreturn [{\n  json: {\n    clientPhone: trigger.clientPhone,\n    clientName: trigger.clientName,\n    questionText: trigger.questionText,\n    queryType: parsed.queryType || 'other',\n    clientNameGuess: parsed.clientNameGuess,\n    searchTerm: parsed.searchTerm\n  }\n}];"
