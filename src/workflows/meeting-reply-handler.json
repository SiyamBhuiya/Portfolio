      "parameters": {
        "jsCode": "// Merge the client's Notion record with their raw incoming message\nconst incoming = $('Normalize Incoming Message').first().json;\nconst client = $input.first().json;\n\nreturn [{\n  json: {\n    notionPageId: (client.id || '').replace(/-/g, ''),\n    clientName: client.property_name || client.property_Name || 'Client',\n    clientPhone: incoming.phone,\n    option1_text: client.property_option_1 || '',\n    option2_text: client.property_option_2 || '',\n    option1_start: client.property_option1start || '',\n    option1_end: client.property_option1_end || '',\n    option2_start: client.property_option2_start || '',\n    option2_end: client.property_option2_end || '',\n    messageText: incoming.messageText,\n    messageTextLower: incoming.messageTextLower,\n    buttonPayload: incoming.buttonPayload\n  }\n}];"
      },
      "id": "1339c0b7-242f-4fdb-8267-dda8e25cd5f7",
