    {
      "parameters": {
        "jsCode": "// Quick keyword classification before falling back to AI\nconst msg = ($json.messageTextLower || '').toString();\n\nlet intent = 'UNCLEAR';\n\n// Exact match for the WhatsApp template's actual button labels - this is the strongest signal\nconst opt1Patterns = [/^time 1$/, /^1$/, /\\boption 1\\b/, /\\bfirst\\b/, /\\bone\\b/];\nconst opt2Patterns = [/^time 2$/, /^2$/, /\\boption 2\\b/, /\\bsecond\\b/, /\\btwo\\b/];\nconst negativePatterns = [/\\bno\\b/, /not available/, /can'?t/, /cannot/, /doesn'?t work/, /different time/, /another time/, /busy/, /unavailable/];\n\nif (opt1Patterns.some(p => p.test(msg))) intent = 'BOOK_OPTION_1';\nelse if (opt2Patterns.some(p => p.test(msg))) intent = 'BOOK_OPTION_2';\nelse if (negativePatterns.some(p => p.test(msg))) intent = 'NEEDS_RESCHEDULE';\nelse if (msg.length > 8) intent = 'NEEDS_AI_CHECK';\n\nreturn [{ json: { ...$json, quickIntent: intent } }];"
      },
