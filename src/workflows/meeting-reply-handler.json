{
  "name": "Meeting Reply Handler - Wassenger Inbound",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Extract and normalize phone number\nlet rawNumber = String(input.from || '').replace(/\\D/g, '');\n\nlet formattedNumber = rawNumber;\n\nif (rawNumber.startsWith('880') && rawNumber.length === 13) {\n  // Bangladesh number: strip '880' country code -> 10 digits\n  formattedNumber = rawNumber.slice(3);\n} else if (rawNumber.startsWith('65') && rawNumber.length === 10) {\n  // Singapore number: strip '65' country code -> 8 digits\n  formattedNumber = rawNumber.slice(2);\n} else if (rawNumber.startsWith('1') && rawNumber.length === 11) {\n  // US/exception number: format as 1-XXXXXXXXXX\n  formattedNumber = '1-' + rawNumber.slice(1);\n}\n\n// The actual WhatsApp message text - this was missing entirely before, causing every downstream node to see 'undefined'\nconst messageText = (input.textBody || input.message || input.text || '').trim();\n\nreturn [{\n  json: {\n    from: formattedNumber,\n    phone: formattedNumber,\n    messageText,\n    messageTextLower: messageText.toLowerCase(),\n    chatId: input.chatId,\n    deviceId: input.deviceId\n  }\n}];"
      },
      "id": "8e18818d-7173-4b77-bbf7-326829f5bbc7",
