    {
      "parameters": {
        "jsCode": "// Determine which slot actually got booked (Option 1, Option 2, or a proposed new time)\n// and build a single clean, human-readable time string for Notion - drop the unused option entirely.\nconst j = $('Route By Final Intent').first().json;\nconst calendarEvent = $json; // the Google Calendar node's own output\n\nlet chosenIso = null;\n\nif (j.finalIntent === 'BOOK_OPTION_1') {\n  chosenIso = j.option1_start;\n} else if (j.finalIntent === 'BOOK_OPTION_2') {\n  chosenIso = j.option2_start;\n} else if (j.finalIntent === 'PROPOSED_NEW_TIME') {\n  chosenIso = j.proposedDatetimeIso;\n}\n\nfunction ordinal(n) {\n  const s = ['th', 'st', 'nd', 'rd'];\n  const v = n % 100;\n  return n + (s[(v - 20) % 10] || s[v] || s[0]);\n}\n\nfunction formatTimeLine(iso) {\n  if (!iso) return 'Time: not confirmed';\n  const d = new Date(iso);\n  const date = d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });\n  const time = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });\n  return `Time: ${date} ${time}`;\n}\n\nfunction formatShort(iso) {\n  if (!iso) return 'Meeting scheduled';\n  const d = new Date(iso);\n  const day = ordinal(d.getDate());\n  const month = d.toLocaleDateString('en-US', { month: 'long' });\n  return `${day} ${month} meeting scheduled`;\n}\n\nreturn [{\n  json: {\n    notionPageId: j.notionPageId,\n    clientName: j.clientName,\n    clientPhone: j.clientPhone,\n    finalIntent: j.finalIntent,\n    calendarEventId: calendarEvent.id || null,\n    calendarEventLink: calendarEvent.htmlLink || null,\n    confirmedTimeText: formatTimeLine(chosenIso),\n    shortConfirmationText: formatShort(chosenIso)\n  }\n}];"
      },
